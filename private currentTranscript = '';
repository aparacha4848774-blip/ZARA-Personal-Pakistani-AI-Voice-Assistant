import {
  mapSpeechErrorToMessage,
  SupportedLanguage,
} from '../logic/languageDetector.ts';

type TranscriptCallback = (
  transcript: string,
  isFinal: boolean
) => void;

type StatusCallback = (isListening: boolean) => void;

type ErrorCallback = (
  error: string,
  friendlyMessage: string
) => void;

class SpeechRecognitionEngine {
  private recognition: any = null;
  private isListening = false;
  private shouldKeepListening = false;
  private isLockedOut = false;

  private silenceTimer: ReturnType<typeof setTimeout> | null = null;
  private restartTimeout: ReturnType<typeof setTimeout> | null = null;

  private currentTranscript = '';
  private pendingFinalTranscript = '';
  private currentInterimTranscript = '';
  private lastFinalResultIndex = -1;

  private onTranscript: TranscriptCallback | null = null;
  private onStatus: StatusCallback | null = null;
  private onError: ErrorCallback | null = null;
  private onSilenceTrigger: (() => void) | null = null;

  private silenceTimeoutMs = 1500;
  private consecutiveErrors = 0;
  private maxConsecutiveErrors = 4;
  private silenceAlreadySubmitted = false;

  private currentLanguageCode = 'ur-PK';
  private currentAppLanguage: SupportedLanguage = 'roman_urdu';

  constructor() {
    this.initRecognition();
  }

  private resetTranscriptState() {
    this.currentTranscript = '';
    this.pendingFinalTranscript = '';
    this.currentInterimTranscript = '';
    this.lastFinalResultIndex = -1;
  }

  private initRecognition() {
    if (typeof window === 'undefined') {
      return;
    }

    const SpeechRecognition =
      (window as any).SpeechRecognition ||
      (window as any).webkitSpeechRecognition;

    if (!SpeechRecognition) {
      console.warn(
        'Web Speech API is not supported. Please use Chrome or Edge.'
      );
      return;
    }

    try {
      this.recognition = new SpeechRecognition();
      this.recognition.continuous = true;
      this.recognition.interimResults = true;
      this.recognition.lang = this.currentLanguageCode;

      this.recognition.onstart = () => {
        if (this.isLockedOut) {
          try {
            this.recognition.abort();
          } catch {
            // Recognition may already have stopped.
          }

          this.isListening = false;
          this.onStatus?.(false);
          return;
        }

        this.isListening = true;
        this.consecutiveErrors = 0;
        this.silenceAlreadySubmitted = false;
        this.onStatus?.(true);
      };

      this.recognition.onresult = (event: any) => {
        if (this.isLockedOut) {
          return;
        }

        const results = event.results;

        if (!results) {
          return;
        }

        /*
         * Rebuild the transcript from the browser's current result list.
         * Final segments are retained; interim segments are refreshed
         * rather than appended repeatedly.
         */
        let finalSegments: string[] = [];
        let interimSegments: string[] = [];

        for (let i = 0; i < results.length; i += 1) {
          const result = results[i];
          const segment = result?.[0]?.transcript?.trim();

          if (!segment) {
            continue;
          }

          if (result.isFinal) {
            finalSegments.push(segment);
          } else {
            interimSegments.push(segment);
          }
        }

        this.pendingFinalTranscript = finalSegments.join(' ').trim();
        this.currentInterimTranscript = interimSegments.join(' ').trim();

        const transcript = [
          this.pendingFinalTranscript,
          this.currentInterimTranscript,
        ]
          .filter(Boolean)
          .join(' ')
          .replace(/\s+/g, ' ')
          .trim();

        if (!transcript) {
          return;
        }

        this.currentTranscript = transcript;
        this.silenceAlreadySubmitted = false;

        /*
         * Do not immediately submit final browser segments.
         * Wait for silence so the complete phrase can be submitted once.
         */
        this.onTranscript?.(transcript, false);

        this.resetSilenceTimer();
      };

      this.recognition.onerror = (event: any) => {
        const errType = event?.error || 'unknown';

        if (errType === 'no-speech' || errType === 'aborted') {
          return;
        }

        this.consecutiveErrors += 1;

        const mapped = mapSpeechErrorToMessage(
          errType,
          this.currentAppLanguage
        );

        if (
          errType === 'not-allowed' ||
          errType === 'permission-denied' ||
          errType === 'service-not-allowed'
        ) {
          this.shouldKeepListening = false;
        }

        console.warn(
          `[SpeechRecognition] ${errType}:`,
          mapped.friendlyMessage
        );

        this.onError?.(errType, mapped.friendlyMessage);

        if (
          this.consecutiveErrors >= this.maxConsecutiveErrors ||
          mapped.isFatal
        ) {
          console.warn(
            '[SpeechRecognition] Too many errors. Auto-restart paused.'
          );

          this.shouldKeepListening = false;
        }
      };

      this.recognition.onend = () => {
        this.isListening = false;
        this.onStatus?.(false);

        if (
          this.shouldKeepListening &&
          !this.isLockedOut &&
          this.consecutiveErrors < this.maxConsecutiveErrors
        ) {
          if (this.restartTimeout) {
            clearTimeout(this.restartTimeout);
          }

          this.restartTimeout = setTimeout(() => {
            this.restartTimeout = null;

            if (!this.shouldKeepListening || this.isLockedOut) {
              return;
            }

            try {
              this.recognition.start();
            } catch {
              // The browser may still consider recognition active.
            }
          }, 300);
        }
      };
    } catch (error) {
      console.warn(
        'Failed to initialize SpeechRecognition:',
        error
      );
    }
  }

  public setCallbacks(
    onTranscript: TranscriptCallback,
    onStatus: StatusCallback,
    onError: ErrorCallback,
    onSilence: () => void
  ) {
    this.onTranscript = onTranscript;
    this.onStatus = onStatus;
    this.onError = onError;
    this.onSilenceTrigger = onSilence;
  }

  public setSilenceTimeout(ms: number) {
    this.silenceTimeoutMs = Math.max(250, ms);
  }

  public setLockedOut(locked: boolean) {
    this.isLockedOut = locked;

    if (!locked) {
      return;
    }

    this.shouldKeepListening = false;
    this.clearSilenceTimer();

    if (this.restartTimeout) {
      clearTimeout(this.restartTimeout);
      this.restartTimeout = null;
    }

    this.resetTranscriptState();
    this.silenceAlreadySubmitted = true;

    if (this.recognition && this.isListening) {
      try {
        if (typeof this.recognition.abort === 'function') {
          this.recognition.abort();
        } else {
          this.recognition.stop();
        }
      } catch {
        // Recognition may already have stopped.
      }
    }

    this.isListening = false;
    this.onStatus?.(false);
  }

  public getIsLockedOut(): boolean {
    return this.isLockedOut;
  }

  public start() {
    if (this.isLockedOut) {
      return;
    }

    this.shouldKeepListening = true;
    this.consecutiveErrors = 0;
    this.silenceAlreadySubmitted = false;

    if (!this.recognition) {
      this.initRecognition();
    }

    if (this.recognition && !this.isListening) {
      try {
        this.recognition.start();
      } catch {
        // Recognition may already be active.
      }
    }
  }

  public stop() {
    this.shouldKeepListening = false;
    this.clearSilenceTimer();

    if (this.restartTimeout) {
      clearTimeout(this.restartTimeout);
      this.restartTimeout = null;
    }

    if (this.recognition && this.isListening) {
      try {
        this.recognition.stop();
      } catch {
        // Recognition may already have stopped.
      }
    }

    this.isListening = false;
    this.resetTranscriptState();
    this.silenceAlreadySubmitted = false;
    this.onStatus?.(false);
  }

  public resetSilenceTimer() {
    this.clearSilenceTimer();

    this.silenceTimer = setTimeout(() => {
      this.silenceTimer = null;

      if (
        !this.currentTranscript ||
        !this.onSilenceTrigger ||
        this.isLockedOut ||
        this.silenceAlreadySubmitted
      ) {
        return;
      }

      this.silenceAlreadySubmitted = true;

      /*
       * Call the silence handler before clearing anything.
       * The handler may need the transcript draft to submit the query.
       */
      this.onSilenceTrigger();

      this.resetTranscriptState();
    }, this.silenceTimeoutMs);
  }

  public clearSilenceTimer() {
    if (this.silenceTimer) {
      clearTimeout(this.silenceTimer);
      this.silenceTimer = null;
    }
  }

  public setLanguage(
    lang: 'roman_urdu' | 'english' | 'urdu'
  ) {
    this.currentAppLanguage = lang;

    const langCode = lang === 'english' ? 'en-US' : 'ur-PK';

    this.currentLanguageCode = langCode;

    if (!this.recognition) {
      return;
    }

    this.recognition.lang = langCode;

    if (this.isListening && !this.isLockedOut) {
      try {
        this.recognition.abort();
      } catch {
        // Recognition may already have stopped.
      }

      if (this.restartTimeout) {
        clearTimeout(this.restartTimeout);
      }

      this.restartTimeout = setTimeout(() => {
        this.restartTimeout = null;

        if (this.shouldKeepListening && !this.isLockedOut) {
          try {
            this.recognition.start();
          } catch {
            // Recognition may still be stopping.
          }
        }
      }, 300);
    }
  }

  public getLanguage(): string {
    return this.recognition?.lang || this.currentLanguageCode;
  }

  public isAvailable(): boolean {
    return Boolean(
      typeof window !== 'undefined' &&
        (
          (window as any).SpeechRecognition ||
          (window as any).webkitSpeechRecognition
        )
    );
  }
}

export const speechRecognitionEngine =
  new SpeechRecognitionEngine();
