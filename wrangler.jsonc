{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zara-personal-pakistani-ai-voice-assistant",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zara-assistant-staging",
      "database_id": "c6f6e3dc-d53e-417b-ad14-e5d7d38a922d",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 22 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
