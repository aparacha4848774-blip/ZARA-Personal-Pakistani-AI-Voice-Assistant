6. Functions & Triggers
Trigger: update_updated_at
Auto-update updated_at on any row change:
code
SQL
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = now();
  RETURN NEW;
END;
$$ language 'plpgsql';

-- Apply to tables with updated_at
CREATE TRIGGER update_user_profile_updated_at
  BEFORE UPDATE ON user_profile
  FOR EACH ROW EXECUTE PROCEDURE update_updated_at_column();

CREATE TRIGGER update_memory_entries_updated_at
  BEFORE UPDATE ON memory_entries
  FOR EACH ROW EXECUTE PROCEDURE update_updated_at_column();
Function: get_recent_context
Return last N messages for Gemini context:
code
SQL
CREATE OR REPLACE FUNCTION get_recent_context(
  p_conversation_id UUID,
  p_limit INTEGER DEFAULT 20
)
RETURNS TABLE(role TEXT, content TEXT, emotion TEXT) AS $$
BEGIN
  RETURN QUERY
  SELECT m.role, m.content, m.emotion
  FROM messages m
  WHERE m.conversation_id = p_conversation_id
  ORDER BY m.created_at DESC
  LIMIT p_limit;
END;
$$ LANGUAGE plpgsql;
Function: get_active_memories
Return all active memory entries for ZARA context:
code
SQL
CREATE OR REPLACE FUNCTION get_active_memories()
RETURNS TABLE(category TEXT, key TEXT, value TEXT, importance TEXT) AS $$
BEGIN
  RETURN QUERY
  SELECT me.category, me.key, me.value, me.importance
  FROM memory_entries me
  WHERE me.is_active = true
    AND me.user_approved = true
    AND (me.expires_at IS NULL OR me.expires_at > now())
  ORDER BY
    CASE me.importance WHEN 'high' THEN 1 WHEN 'medium' THEN 2 ELSE 3 END,
    me.updated_at DESC;
END;
$$ LANGUAGE plpgsql;
